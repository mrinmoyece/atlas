# Copy to .env. With no configuration at all, Atlas runs offline with the
# deterministic scripted model — but the API denies every request until
# ATLAS_API_KEYS is set. That is deliberate (deny by default).

# --- required for the API ---
# format: key_id:sha256(key):role[,role];...
# generate: python -c "from atlas.security import hash_key; print(hash_key('my-key'))"
# ATLAS_API_KEYS=dev:<sha256>:analyst

# --- model ---
# ATLAS_PROVIDER=anthropic
# ATLAS_MODEL=claude-sonnet-4-5
# ATLAS_ANTHROPIC_API_KEY=sk-ant-...

# --- governance ---
# ATLAS_MAX_STEPS_PER_SPECIALIST=12
# ATLAS_MAX_COST_USD=5.0
# Per-principal API limits. ATLAS_DAILY_SPEND_USD must be >= ATLAS_MAX_COST_USD
# or the service refuses to start: a run reserves its full ceiling up front,
# so a daily cap below that ceiling rejects every request having spent nothing.
# ATLAS_DAILY_SPEND_USD=25.0
# ATLAS_REQUESTS_PER_MINUTE=60
# ATLAS_RATE_LIMIT_BURST=15
# Bound per-principal request buckets; excess identities share a fail-safe bucket.
# ATLAS_RATE_LIMIT_MAX_BUCKETS=10000
# Idle request buckets are evicted after this many seconds.
# ATLAS_RATE_LIMIT_BUCKET_TTL_S=3600
# ATLAS_CONTEXT_TOKEN_BUDGET=12000

# --- memory ---
# ATLAS_MEMORY_ENABLED=true
# ATLAS_MEMORY_TOP_K=3

# --- observability ---
# ATLAS_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# Retain at most this many audit entries in process memory.
# ATLAS_AUDIT_MEMORY_MAX_ENTRIES=10000
# Optional append-only local persistence. Put this on a durable mounted volume;
# JSONL is not an off-box WORM/compliance archive.
# ATLAS_AUDIT_SINK=/var/lib/atlas/audit.jsonl
